# Database Configuration Template
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi database Anda

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=seleksi_da
DB_PORT=3306

# Catatan untuk Deployment Railway:
# Environment variable MYSQLHOST, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, MYSQLPORT
# akan otomatis terdeteksi jika disediakan oleh platform Railway.
